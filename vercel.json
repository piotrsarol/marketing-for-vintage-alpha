{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/auth/login", "destination": "/api/auth-login" },
    { "source": "/api/auth/logout", "destination": "/api/auth-logout" },
    { "source": "/api/admin/session", "destination": "/api/admin-session" },
    { "source": "/api/publishing/publish", "destination": "/api/publishing-publish" },
    { "source": "/api/publishing/process", "destination": "/api/publishing-process" },
    { "source": "/api/publishing/retry", "destination": "/api/publishing-process" },
    { "source": "/api/publishing/cleanup", "destination": "/api/publishing-process" },
    { "source": "/api/campaigns/latest", "destination": "/api/campaigns-latest" },
    { "source": "/api/campaigns/run", "destination": "/api/campaigns-run" },
    { "source": "/api/trends/discover", "destination": "/api/trends-discover" }
  ],
  "functions": {
    "api/campaigns-run.ts": {
      "maxDuration": 60
    }
  }
}
